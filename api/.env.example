PORT=8181
LOG_LEVEL=info

# 任意。設定すると X-API-Key ヘッダーと完全一致したリクエストだけが /voiceroid2/* を呼べる。
# 空または未設定なら認証は無効。
API_KEY=

# helper.exe (DLL 直叩き版) のパス。
VOICEROID2_HELPER_PATH=C:\path\to\voiceroid2-server\helper\bin\Release\net481\voiceroid2-helper.exe
VOICEROID2_TIMEOUT_MS=120000

# VOICEROID2 インストールディレクトリ。aitalked.dll, Voice/, Lang/, aitalk.lic が
# ここの直下にある前提。
VOICEROID2_INSTALL_DIR=C:\Program Files (x86)\AHS\VOICEROID2

# aitalked.dll の認証コードシード (= VoiceroidEditor の AppSettings.LicenseKey)。
# 初回 1 回だけ VOICEROID2 エディタを起動して以下のコマンドで取得する:
#   voiceroid2-helper.exe --get-key
# 取得後はこの値を VOICEROID2_AUTH_CODE に貼り付ければ以後エディタ起動は不要。
VOICEROID2_AUTH_CODE=

# 任意。リクエストで voice_db を省略したときのデフォルト (Voice/ 配下のフォルダ名)。
# 例: kiritan_44, yukari_44, akari_22
VOICEROID2_DEFAULT_VOICE_DB=

# 任意。リクエストで voice_name を省略したときのデフォルト。
# 未指定なら voice_db の先頭話者が使われる。
VOICEROID2_DEFAULT_VOICE_NAME=
