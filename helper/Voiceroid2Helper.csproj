<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net481</TargetFramework>
    <PlatformTarget>x86</PlatformTarget>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AssemblyName>voiceroid2-helper</AssemblyName>
    <RootNamespace>Voiceroid2Helper</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Codeer.Friendly.Windows.Grasp" Version="2.16.0" />
    <PackageReference Include="RM.Friendly.WPFStandardControls" Version="1.63.0" />
  </ItemGroup>
</Project>
